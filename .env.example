# Copie este arquivo para .env e ajuste os valores localmente.
# O arquivo .env é carregado automaticamente e nunca deve ser versionado.
DJANGO_SECRET_KEY=troque-por-uma-chave-segura
# Use somente durante uma rotação de chave e remova após as sessões antigas expirarem.
# DJANGO_SECRET_KEY_FALLBACKS=chave-anterior
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Produção com HTTPS:
# DJANGO_DEBUG=0
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SESSION_COOKIE_SECURE=1
# DJANGO_CSRF_COOKIE_SECURE=1
# DJANGO_SECURE_HSTS_SECONDS=31536000

# MySQL Community Server 8.4 LTS (obrigatório).
DB_NAME=agromonitor
DB_USER=agromonitor_app
DB_PASSWORD=troque-por-uma-senha-segura
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TEST_NAME=test_agromonitor
