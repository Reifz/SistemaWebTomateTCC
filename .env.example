# Copie este arquivo para .env e ajuste os valores localmente.
# O Django ainda não carrega .env automaticamente; exporte as variáveis no
# terminal ou adicione uma biblioteca própria para isso.
DJANGO_SECRET_KEY=troque-por-uma-chave-segura
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Produção com HTTPS:
# DJANGO_DEBUG=0
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SESSION_COOKIE_SECURE=1
# DJANGO_CSRF_COOKIE_SECURE=1
# DJANGO_SECURE_HSTS_SECONDS=31536000

# O SQLite é usado quando DB_ENGINE não é definido.
# Para usar MySQL, descomente e preencha as variáveis abaixo.
# DB_ENGINE=mysql
# DB_NAME=agromonitor
# DB_USER=usuario
# DB_PASSWORD=senha
# DB_HOST=127.0.0.1
# DB_PORT=3306
